{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "isolatedModules": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  // selftest.* 是开发期自测脚本（只用 npx tsx 跑，从不进 dist），它们用了 import.meta；
  // 而 package.json 未声明 type:module，tsc 会按 CJS 输出并拒绝 import.meta（TS1470），
  // 导致 `npm run build` 挂掉。自测不参与产物，故排除。
  "exclude": ["node_modules", "dist", "src/**/*.selftest.ts", "src/**/*.selftest.tooLarge.ts"]
}
