// 零废弃知识库 · 自有数据库 schema 骨架（T00）
// 字段来源：《P3P4-开发总规划与任务拆解.md》v1.1 §5「数据表」
// 注意：datasource 直接复用既有 backend/.env 里的 DB_URL（禁止改动 .env）。
// 本卡只做 schema 骨架，不做 migrate 落库。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DB_URL")
}

/// 注册用户（公众五字段注册：姓名/机构/职业/关注议题/电话 + 密码哈希）
model User {
  id           String   @id @default(cuid())
  name         String
  org          String
  occupation   String
  /// 关注议题（多选数组，落库用 JSON 数组串，如 ["塑料污染","食物浪费"]；读出时 JSON.parse）
  topics       String   @default("[]")
  /// 联系电话（11 位手机号；T02 加唯一约束 -> 重复注册返回 409）
  phone        String   @unique
  /// 密码哈希（bcrypt 哈希串，明文密码永不入库）
  passwordHash String
  /// 是否管理员（看板可见性控制）
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 反向关系（Prisma 要求关系两端都有声明）
  questions    QuestionLog[]
  downloads    DownloadLog[]
  submissions  Submission[]

  @@map("users")
}

/// 提问日志（看板：提问趋势 / 无答案率 / 热词）
/// 数据来源待 V2 验证后确定（API 轮询 或 前端埋点），字段口径两种方案都兼容。
model QuestionLog {
  id        String   @id @default(cuid())
  /// 会话 ID（WeKnora session id）
  sessionId String
  /// 提问原文
  question  String
  /// 是否命中知识库（false = 无答案）
  hit       Boolean  @default(false)
  /// 来源：widget=官方挂件，api=轮询拉取，web=自建前端埋点
  source    String   @default("widget")
  /// 可选关联提问人（挂件免登录时为空）
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@map("question_logs")
}

/// 下载日志（看板：下载排行）
/// T04 起真正写入：GET /api/docs/:id/download 每次成功开流前记一条。
model DownloadLog {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// WeKnora 知识（文件）ID
  docId    String
  /// 资料标题快照，便于看板展示与历史留痕
  docTitle String @default("")
  /// T04：实际下发给浏览器的重命名文件名（"年份-机构-标题.ext"）
  fileName String @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([docId])
  @@map("download_logs")
}

/// 行为事件日志（T07 · PRD R04 基础版）
/// 统一埋点表：7 类事件（page_view/search/preview/download/ai_ask/register/feedback_submit）
/// 全部走这张表，前端统一 POST /api/track。webhook 路线已被 V2 实验否决（v0.8.2 无嵌入渠道回调），
/// 故本表只由前端埋点 + 后端接口写入（规划 §3.3 方案乙）。
/// 字段口径见 docs/task-cards/T07-契约.md §1。
model EventLog {
  id        String   @id @default(cuid())
  /// 事件名：7 类白名单之一（见 track.types.ts TRACK_EVENTS）
  event     String
  /// 用户 ID；null = 匿名访客。刻意不建外键：删账号不该带走统计（与 QuestionLog 的 SetNull 不同，
  /// 这里连外键都不要，避免写入时因用户不存在而整条丢失）
  userId    String?
  /// 会话标识（前端 sessionStorage 生成；空串 = 无会话）
  sessionId String   @default("")
  /// 载荷 JSON 串（各事件自定义；序列化后 ≤4000 字符由接口侧保证）
  payload   String   @default("{}")
  /// 页面来源（路由 fullPath，含 query）
  path      String   @default("")
  /// 派生列：search 检索词（归一后），供 Top10 / 零结果词走索引
  term      String   @default("")
  /// 派生列：ai_ask 无答案判定；null = 未判定（前端没上报回答证据）。
  /// 判定规则见 track.answer.ts judgeNoAnswer（任务卡验收④）
  noAnswer  Boolean?
  /// 派生列：search 结果是否为零（值来自本服务 /api/docs 的 zeroResult）
  zeroResult Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([sessionId])
  @@index([event, term])
  @@index([event, noAnswer])
  @@map("event_logs")
}

/// 公众提交的资料（P2：状态「待审核」，通过后由管理员手动在 WeKnora 后台入库）
/// 状态取值：pending=待审核，approved=通过，rejected=驳回
model Submission {
  id             String   @id @default(cuid())
  /// 提交人（可为空：免登录提交）
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String
  org            String   @default("")
  year           String   @default("")
  docType        String   @default("")
  domain         String   @default("")
  /// 提交内容说明
  description    String   @default("")
  /// 文件存储位置（P2 落地时确定：自建上传 or 外部链接）
  fileUrl        String?
  fileName       String   @default("")
  status         String   @default("pending")
  /// 审核意见
  reviewComment  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@map("submissions")
}

/// 知识元数据索引（T01）
/// 来源：WeKnora `GET /api/v1/knowledge-bases/:id/knowledge` 的每条 knowledge。
/// 用途：供后续「书架」按 年份/知识类型/知识领域/发布机构 筛选与排序（T03）。
/// 约束（主控已实测）：WeKnora keyword 搜不到 custom_metadata 值，列表接口也没有
/// 按元数据筛选/排序的参数 —— 所以筛选能力必须落在本表，故必须本地全量索引。
/// 注意：WeKnora 侧 tag_ids 用逗号串，SQLite 无原生数组/JSON 列，故用 String 存序列化值。
model KnowledgeIndex {
  /// WeKnora knowledge id（跨库唯一，直接作主键，upsert 用）
  knowledgeId     String   @id
  /// 所属 WeKnora 知识库 ID（便于多库场景按库刷新/清理）
  knowledgeBaseId String   @default("")
  title           String
  /// 原始文件名（搜索与展示都要原名，故与 title 分开存；WeKnora 两者可能不同）
  fileName        String   @default("")
  /// 文件扩展名（xlsx/pdf/...；空串表示上游未给）
  fileType        String   @default("")
  /// 文件字节数（上游为 0 时按 0 存，不猜）
  fileSize        Int      @default(0)
  /// 自定义元数据 JSON 串（键如 年份/知识类型/知识领域/知识发布机构）
  customMetadata  String   @default("{}")
  /// 标签 JSON 数组串（WeKnora 侧 tags 可能是 null，这里统一存 "[]"）
  tags            String   @default("[]")

  // ---- T03 书架：从 custom_metadata 解析出的可检索维度 ----
  // 空值统一存空串（不是 null），便于 SQLite 直接 GROUP BY 出"未标注"分组。
  /// 清洗后的可读标题（去公文壳/文号/扩展名），参与 q= 匹配
  readableTitle   String   @default("")
  /// 年份（来自 custom_metadata."年份"；空 = 未标注，排序时恒排最后）
  year            String   @default("")
  /// 发布机构（来自 custom_metadata."知识发布机构"）
  org             String   @default("")
  /// 知识类型（来自 custom_metadata."知识类型"）
  docType         String   @default("")
  /// 主题多值（来自 custom_metadata."知识领域"，按 ,/、/；/空格 拆成 JSON 数组串）
  topics          String   @default("[]")
  /// WeKnora 侧最后更新时间（原样保留）
  sourceUpdatedAt DateTime?
  /// 本地索引时间（每次 upsert 刷新）
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([docType])
  @@index([org])
  @@index([year])
  @@map("knowledge_index")
}

// 关系说明：
// - User 1—N QuestionLog / DownloadLog / Submission
// - 三张日志表都用 onDelete 语义：删用户时日志保留（SetNull）或级联清理（DownloadLog）
// - KnowledgeIndex 与 User 无关系：纯 WeKnora 侧镜像表（独立落库、独立清理）