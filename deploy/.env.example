# 零废弃知识库 · 环境变量样例
# ⚠️ 真实值只写进 backend/.env（已 gitignore），本文件仅供结构参考，禁止填入真实密钥。
# 复制方法：cp deploy/.env.example backend/.env

# ---------- 自建后端 ----------
NODE_ENV=production
PORT=4000

# WeKnora 内网地址与密钥（引擎跑在另一个 compose / 别的机器时改这里）
WEKNORA_BASE_URL=http://localhost:8080
WEKNORA_API_KEY=replace-me
WEKNORA_KB_ID=replace-me
WEKNORA_CHANNEL_ID=replace-me
WEKNORA_PUBLISH_TOKEN=replace-me

# 自建后端签名密钥（随机长串，例：openssl rand -hex 32）
JWT_SECRET=replace-me

# 自建后端的 SQLite，只存登录用户和本站业务数据，不要指向 WeKnora 的数据库。
# 路径相对 backend/prisma/schema.prisma，下面这一行落到 backend/data/app.db（该目录已 gitignore）。
DB_URL=file:../data/app.db
