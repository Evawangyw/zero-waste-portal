{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "rm -rf *": "deny",
      "git push*": "deny",
      "*curl*http*": "allow",
      "npm install*": "allow",
      "pnpm install*": "allow",
      "pnpm add*": "allow",
      "docker*": "deny",
      "sudo*": "deny"
    },
    "webfetch": "deny",
    "external_directory": "deny"
  }
}
